<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HungryCalendar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&family=Playfair+Display:ital,wght@0,700;1,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div id="app">
        <header>
            <nav class="container d-flex justify-content-between align-items-center">
                <div class="logo">Hungry<span>Calendar</span></div>
                <div class="nav-links">
                    <a asp-page="/Index" style="color: var(--text-muted); text-decoration: none; margin-right: 1.5rem; font-size: 0.9rem;">Reservations</a>
                    <a asp-page="/Admin" style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem;">Admin View</a>
                </div>
            </nav>
        </header>

        <main role="main">
            @RenderBody()
        </main>

        <footer>
            <div class="container">
                <p>&copy; 2026 HungryCalendar. All rights reserved.</p>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
