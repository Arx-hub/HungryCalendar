@page
@model AdminModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container">
    @if (!Model.IsLoggedIn)
    {
        <div class="hero">
            <h1>Admin Login</h1>
            <p>Manage reservations and restaurant settings.</p>
        </div>

        <div class="booking-card" style="max-width: 400px;">
            <form method="post" asp-page-handler="Login">
                <div class="input-group mb-3">
                    <label>Username</label>
                    <input asp-for="Username" value="admin" class="form-control" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--glass-border); color: white; border-radius: 12px; padding: 1rem;" />
                </div>
                <div class="input-group mb-4">
                    <label>Password</label>
                    <input asp-for="Password" type="password" value="1234" class="form-control" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--glass-border); color: white; border-radius: 12px; padding: 1rem;" />
                </div>
                
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="error-message">@Model.ErrorMessage</div>
                }

                <button type="submit" class="btn-primary">Login</button>
            </form>
        </div>
    }
    else
    {
        <div class="admin-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4 mb-5">
            <div>
                <h1>Admin Dashboard</h1>
                <p class="text-muted mb-0">Managing reservations for <strong>@Model.Date</strong></p>
            </div>
            
            <div class="d-flex flex-wrap align-items-center gap-3">
                <form method="get" class="search-form d-flex align-items-center">
                    <input type="hidden" name="Date" value="@Model.Date" />
                    <div class="search-input-wrapper">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" name="SearchQuery" value="@Model.SearchQuery" placeholder="Search name, phone, email..." class="form-control search-input" />
                    </div>
                </form>

                <div class="d-flex align-items-center gap-2">
                    <form method="get" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="SearchQuery" value="@Model.SearchQuery" />
                        <label class="text-muted small text-uppercase fw-bold">Date:</label>
                        <input type="date" name="Date" value="@Model.Date" class="form-control date-input" onchange="this.form.submit()">
                    </form>
                    <form method="post" asp-page-handler="Logout">
                        <button type="submit" class="btn-secondary logout-btn">Logout</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="dashboard-section">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="mb-0">Reservations</h3>
                        <span class="badge bg-primary">@Model.DateReservations.Count Total</span>
                    </div>

                    @if (!Model.DateReservations.Any())
                    {
                        <div class="empty-state">
                            <i class="fas fa-calendar-times mb-3"></i>
                            <p>No reservations found for this selection.</p>
                        </div>
                    }
                    else
                    {
                        <div class="reservation-grid">
                            @foreach (var res in Model.DateReservations)
                            {
                                <div class="reservation-card">
                                    <div class="card-header-res">
                                        <span class="res-time">@res.Time</span>
                                        <span class="res-guests"><i class="fas fa-users me-1"></i>@res.GroupSize</span>
                                    </div>
                                    <div class="card-body-res">
                                        <h4 class="res-name">@res.Name</h4>
                                        <div class="res-contact">
                                            <span><i class="fas fa-envelope me-2"></i>@res.Email</span>
                                            <span><i class="fas fa-phone me-2"></i>@res.Phone</span>
                                        </div>
                                    </div>
                                    <div class="card-footer-res">
                                        <form method="post" asp-page-handler="DeleteReservation" asp-route-id="@res.Id">
                                            <input type="hidden" name="Date" value="@Model.Date" />
                                            <input type="hidden" name="SearchQuery" value="@Model.SearchQuery" />
                                            <button type="submit" class="btn-delete" 
                                                    onclick="return confirm('Are you sure you want to delete this reservation for @res.Name at @res.Time?')">
                                                <i class="fas fa-trash-alt me-1"></i> Remove
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="dashboard-section timeline-section">
                    <h3>Timeline Control</h3>
                    <p class="text-muted small mb-4">Block slots to prevent customer bookings</p>
                    
                    <div class="time-block mb-4">
                        <h4 class="section-subtitle">Lunch Service</h4>
                        <div class="time-grid-admin">
                            @foreach (var t in Model.LunchSlots)
                            {
                                var res = Model.DateReservations.FirstOrDefault(r => r.Time == t);
                                bool isDisabled = Model.DisabledTimes.Contains(t);
                                <form method="post" asp-page-handler="ToggleSlot" asp-route-time="@t">
                                    <input type="hidden" name="Date" value="@Model.Date" />
                                    <input type="hidden" name="SearchQuery" value="@Model.SearchQuery" />
                                    <button type="submit" class="admin-time-slot @(isDisabled ? "is-blocked" : (res != null ? "is-reserved" : "is-available"))" 
                                            title="@(res != null ? $"Reserved by {res.Name}" : (isDisabled ? "Blocked" : "Available"))"
                                            onclick="return confirm('@(isDisabled ? $"Make {t} available again?" : $"Block {t} for all customers?")')">
                                        @t @(res != null ? " (R)" : "")
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                    <div class="time-block">
                        <h4 class="section-subtitle">Afternoon & Dinner</h4>
                        <div class="time-grid-admin">
                            @foreach (var t in Model.AfternoonSlots)
                            {
                                var res = Model.DateReservations.FirstOrDefault(r => r.Time == t);
                                bool isDisabled = Model.DisabledTimes.Contains(t);
                                <form method="post" asp-page-handler="ToggleSlot" asp-route-time="@t">
                                    <input type="hidden" name="Date" value="@Model.Date" />
                                    <input type="hidden" name="SearchQuery" value="@Model.SearchQuery" />
                                    <button type="submit" class="admin-time-slot @(isDisabled ? "is-blocked" : (res != null ? "is-reserved" : "is-available"))" 
                                            title="@(res != null ? $"Reserved by {res.Name}" : (isDisabled ? "Blocked" : "Available"))"
                                            onclick="return confirm('@(isDisabled ? $"Make {t} available again?" : $"Block {t} for all customers?")')">
                                        @t @(res != null ? " (R)" : "")
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    :root {
        --card-bg: rgba(30, 41, 59, 0.7);
        --card-border: rgba(255, 255, 255, 0.1);
        --input-bg: rgba(15, 23, 42, 0.6);
    }

    .admin-header h1 { margin-bottom: 0; font-family: 'Playfair Display', serif; }
    
    /* Search Bar Styles */
    .search-input-wrapper {
        position: relative;
        width: 100%;
        min-width: 250px;
    }
    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        pointer-events: none;
    }
    .search-input {
        background: var(--input-bg) !important;
        border: 1px solid var(--glass-border) !important;
        color: white !important;
        padding: 0.6rem 1rem 0.6rem 2.8rem !important;
        border-radius: 12px !important;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }
    .search-input:focus {
        border-color: var(--primary) !important;
        box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.2);
    }

    .date-input {
        background: var(--input-bg) !important;
        border: 1px solid var(--glass-border) !important;
        color: white !important;
        border-radius: 10px !important;
        font-size: 0.9rem;
        padding: 0.5rem;
    }

    .logout-btn {
        width: auto !important;
        padding: 0.5rem 1.5rem !important;
        font-size: 0.9rem !important;
    }

    /* Dashboard Layout */
    .dashboard-section {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 2rem;
        backdrop-filter: blur(12px);
        height: 100%;
    }

    .section-subtitle {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        margin-bottom: 1rem;
    }

    /* Reservation Grid */
    .reservation-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .reservation-card {
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid var(--card-border);
        border-radius: 15px;
        overflow: hidden;
        transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .reservation-card:hover {
        transform: translateY(-5px);
        border-color: var(--primary);
    }

    .card-header-res {
        padding: 1rem;
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--card-border);
    }
    .res-time {
        font-weight: bold;
        color: var(--primary);
        font-size: 1.1rem;
    }
    .res-guests {
        background: rgba(96, 165, 250, 0.1);
        color: var(--primary);
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
    }

    .card-body-res {
        padding: 1.25rem;
    }
    .res-name {
        margin: 0 0 1rem 0;
        font-size: 1.15rem;
        color: white;
    }
    .res-contact {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .card-footer-res {
        padding: 1rem;
        border-top: 1px solid var(--card-border);
        text-align: right;
    }

    .btn-delete {
        background: transparent;
        border: none;
        color: var(--error);
        font-size: 0.85rem;
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        transition: background 0.3s ease;
    }
    .btn-delete:hover {
        background: rgba(239, 68, 68, 0.1);
    }

    /* Timeline Styles */
    .time-grid-admin {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
    }
    .admin-time-slot {
        width: 100%;
        padding: 0.75rem;
        border-radius: 10px;
        border: 1px solid var(--card-border);
        background: rgba(15, 23, 42, 0.4);
        color: var(--text-muted);
        font-size: 0.85rem;
        transition: all 0.2s ease;
    }
    .admin-time-slot.is-available:hover {
        border-color: var(--primary);
        color: white;
    }
    .admin-time-slot.is-reserved {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }
    .admin-time-slot.is-blocked {
        border-color: var(--error);
        color: var(--error);
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: var(--text-muted);
    }
    .empty-state i {
        font-size: 3rem;
        opacity: 0.3;
    }

    h3 { font-family: 'Playfair Display', serif; margin-bottom: 1.5rem; color: var(--primary); }
</style>
