@page
@model AdminModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container">
    @if (!Model.IsLoggedIn)
    {
        <div class="hero">
            <h1>Admin Login</h1>
            <p>Manage reservations and restaurant settings.</p>
        </div>

        <div class="booking-card" style="max-width: 400px;">
            <form method="post" asp-page-handler="Login">
                <div class="input-group mb-3">
                    <label>Username</label>
                    <input asp-for="Username" value="admin" class="form-control" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--glass-border); color: white; border-radius: 12px; padding: 1rem;" />
                </div>
                <div class="input-group mb-4">
                    <label>Password</label>
                    <input asp-for="Password" type="password" value="1234" class="form-control" style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--glass-border); color: white; border-radius: 12px; padding: 1rem;" />
                </div>
                
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="error-message">@Model.ErrorMessage</div>
                }

                <button type="submit" class="btn-primary">Login</button>
            </form>
        </div>
    }
    else
    {
        <div class="admin-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-4 mb-5">
            <div>
                <h1>Admin Dashboard</h1>
                <p class="text-muted mb-0">Managing reservations for <strong>@Model.Date</strong></p>
            </div>
            
            <div class="d-flex flex-wrap align-items-center gap-3 w-100 justify-content-end">
                <form method="get" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="SearchQuery" value="@Model.SearchQuery" />
                    <label class="text-muted small text-uppercase fw-bold">Date:</label>
                    <input type="date" name="Date" value="@Model.Date" class="form-control date-input" onchange="this.form.submit()">
                </form>

                <form method="get" class="search-form d-flex align-items-center" id="searchForm">
                    <input type="hidden" name="Date" value="@Model.Date" />
                    <div class="search-input-wrapper">
                        <i class="fas fa-search search-icon"></i>
                        <input type="text" name="SearchQuery" value="@Model.SearchQuery" placeholder="Search name, phone, email..." class="form-control search-input" id="searchInput" />
                    </div>
                </form>

                <form method="post" asp-page-handler="Logout">
                    <button type="submit" class="btn-secondary logout-btn">Logout</button>
                </form>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="dashboard-section">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3 class="mb-0">Reservations</h3>
                        <span class="badge bg-primary">@Model.DateReservations.Count Total</span>
                    </div>

                    @if (!Model.DateReservations.Any())
                    {
                        <div class="empty-state">
                            <i class="fas fa-calendar-times mb-3"></i>
                            <p>No reservations found for this selection.</p>
                        </div>
                    }
                    else
                    {
                        <div class="reservation-grid">
                            @foreach (var res in Model.DateReservations)
                            {
                                <div class="reservation-card">
                                    <div class="card-header-res">
                                        <span class="res-time">@res.Time</span>
                                        <span class="res-guests"><i class="fas fa-users me-1"></i>@res.GroupSize</span>
                                    </div>
                                    <div class="card-body-res">
                                        <h4 class="res-name">@res.Name</h4>
                                        <div class="res-contact">
                                            <span><i class="fas fa-envelope me-2"></i>@res.Email</span>
                                            <span><i class="fas fa-phone me-2"></i>@res.Phone</span>
                                        </div>
                                    </div>
                                    <div class="card-footer-res">
                                        <form method="post" asp-page-handler="DeleteReservation" asp-route-id="@res.Id">
                                            <input type="hidden" name="Date" value="@Model.Date" />
                                            <input type="hidden" name="SearchQuery" value="@Model.SearchQuery" />
                                            <button type="submit" class="btn-delete" 
                                                    onclick="return confirm('Are you sure you want to delete this reservation for @res.Name at @res.Time?')">
                                                <i class="fas fa-trash-alt me-1"></i> Remove
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="dashboard-section timeline-section">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="mb-0">Timeline Control</h3>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" id="selectionModeBtn" class="btn-secondary" onclick="enterSelectionMode()" title="Select multiple reservations at once">
                                <i class="fas fa-check-square me-1"></i> Select Multiple
                            </button>
                            <div class="block-day-checkbox-wrapper">
                                <form method="post" asp-page-handler="ToggleBlockWholeDay" style="display: inline;">
                                    <input type="hidden" name="Date" value="@Model.Date" />
                                    <input type="hidden" name="SearchQuery" value="@Model.SearchQuery" />
                                    <input type="checkbox" id="blockWholeDay" name="BlockWholeDay" 
                                           @(Model.IsWholeDayBlocked ? "checked" : "") 
                                           onchange="this.form.submit()"
                                           class="form-check-input" />
                                    <label for="blockWholeDay" class="form-check-label">Block all times</label>
                                </form>
                            </div>
                        </div>
                    </div>
                    <p class="text-muted small mb-4">Block slots to prevent customer bookings</p>
                    
                    <div class="time-block mb-4" id="lunchServicesBlock">
                        <h4 class="section-subtitle">Lunch Service</h4>
                        <div class="time-grid-admin" id="lunchTimeSlots">
                            @foreach (var t in Model.LunchSlots)
                            {
                                var res = Model.DateReservations.FirstOrDefault(r => r.Time == t);
                                bool isDisabled = Model.DisabledTimes.Contains(t);
                                <div class="time-slot-wrapper" data-time="@t">
                                    <form method="post" asp-page-handler="ToggleSlot" asp-route-time="@t">
                                        <input type="hidden" name="Date" value="@Model.Date" />
                                        <input type="hidden" name="SearchQuery" value="@Model.SearchQuery" />
                                        <button type="submit" class="admin-time-slot @(isDisabled ? "is-blocked" : (res != null ? "is-reserved" : "is-available"))" 
                                                title="@(res != null ? $"Reserved by {res.Name}" : (isDisabled ? "Blocked" : "Available"))"
                                                onclick="return confirm('@(isDisabled ? $"Make {t} available again?" : $"Block {t} for all customers?")')">
                                            <input type="checkbox" class="time-slot-checkbox" data-time="@t" style="display: none;" />
                                            <span class="checkbox-display" style="display: none; margin-right: 8px;"></span>
                                            @t @(res != null ? " (R)" : "")
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="time-block" id="afternoonServicesBlock">
                        <h4 class="section-subtitle">Afternoon & Dinner</h4>
                        <div class="time-grid-admin" id="afternoonTimeSlots">
                            @foreach (var t in Model.AfternoonSlots)
                            {
                                var res = Model.DateReservations.FirstOrDefault(r => r.Time == t);
                                bool isDisabled = Model.DisabledTimes.Contains(t);
                                <div class="time-slot-wrapper" data-time="@t">
                                    <form method="post" asp-page-handler="ToggleSlot" asp-route-time="@t">
                                        <input type="hidden" name="Date" value="@Model.Date" />
                                        <input type="hidden" name="SearchQuery" value="@Model.SearchQuery" />
                                        <button type="submit" class="admin-time-slot @(isDisabled ? "is-blocked" : (res != null ? "is-reserved" : "is-available"))" 
                                                title="@(res != null ? $"Reserved by {res.Name}" : (isDisabled ? "Blocked" : "Available"))"
                                                onclick="return confirm('@(isDisabled ? $"Make {t} available again?" : $"Block {t} for all customers?")')">
                                            <input type="checkbox" class="time-slot-checkbox" data-time="@t" style="display: none;" />
                                            <span class="checkbox-display" style="display: none; margin-right: 8px;"></span>
                                            @t @(res != null ? " (R)" : "")
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Batch action buttons for time slots - hidden by default -->
                    <div class="batch-actions-timeSlots" id="batchActionsTimeSlots" style="display: none; margin-top: 2rem; gap: 1rem;">
                        <button class="btn-delete" id="batchBlockTimeSlotsBtn" onclick="batchBlockTimeSlots()">
                            <i class="fas fa-lock me-1"></i> Block Selected Times
                        </button>
                        <button class="btn-delete" id="batchUnblockTimeSlotsBtn" onclick="batchUnblockTimeSlots()">
                            <i class="fas fa-unlock me-1"></i> Unblock Selected Times
                        </button>
                        <button class="btn-secondary" id="cancelTimeSlotSelectionBtn" onclick="exitTimeSlotSelectionMode()">
                            <i class="fas fa-times me-1"></i> Cancel Selection
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    :root {
        --card-bg: rgba(30, 41, 59, 0.7);
        --card-border: rgba(255, 255, 255, 0.1);
        --input-bg: rgba(15, 23, 42, 0.6);
    }

    .admin-header h1 { margin-bottom: 0; font-family: 'Playfair Display', serif; }
    
    /* Search Bar Styles */
    .search-input-wrapper {
        position: relative;
        width: 100%;
        min-width: 250px;
    }
    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        pointer-events: none;
    }
    .search-input {
        background: var(--input-bg) !important;
        border: 1px solid var(--glass-border) !important;
        color: white !important;
        padding: 0.6rem 1rem 0.6rem 2.8rem !important;
        border-radius: 12px !important;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }
    .search-input:focus {
        border-color: var(--primary) !important;
        box-shadow: 0 0 0 2px rgba(96, 165, 250, 0.2);
    }

    .date-input {
        background: var(--input-bg) !important;
        border: 1px solid var(--glass-border) !important;
        color: white !important;
        border-radius: 10px !important;
        font-size: 0.9rem;
        padding: 0.5rem;
    }

    .logout-btn {
        width: auto !important;
        padding: 0.5rem 1.5rem !important;
        font-size: 0.9rem !important;
    }

    /* Dashboard Layout */
    .dashboard-section {
        background: var(--card-bg);
        border: 1px solid var(--card-border);
        border-radius: 20px;
        padding: 2rem;
        backdrop-filter: blur(12px);
        height: 100%;
    }

    .section-subtitle {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--text-muted);
        margin-bottom: 1rem;
    }

    /* Reservation Grid */
    .reservation-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.5rem;
    }

    .reservation-card {
        background: rgba(15, 23, 42, 0.4);
        border: 1px solid var(--card-border);
        border-radius: 15px;
        overflow: hidden;
        transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .reservation-card:hover {
        transform: translateY(-5px);
        border-color: var(--primary);
    }

    .card-header-res {
        padding: 1rem;
        background: rgba(255, 255, 255, 0.03);
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--card-border);
    }
    .res-time {
        font-weight: bold;
        color: var(--primary);
        font-size: 1.1rem;
    }
    .res-guests {
        background: rgba(96, 165, 250, 0.1);
        color: var(--primary);
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-size: 0.8rem;
    }

    .card-body-res {
        padding: 1.25rem;
    }
    .res-name {
        margin: 0 0 1rem 0;
        font-size: 1.15rem;
        color: white;
    }
    .res-contact {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .card-footer-res {
        padding: 1rem;
        border-top: 1px solid var(--card-border);
        text-align: right;
    }

    .btn-delete {
        background: transparent;
        border: none;
        color: var(--error);
        font-size: 0.85rem;
        padding: 0.4rem 0.8rem;
        border-radius: 8px;
        transition: background 0.3s ease;
    }
    .btn-delete:hover {
        background: rgba(239, 68, 68, 0.1);
    }

    /* Timeline Styles */
    .time-grid-admin {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
    }
    .admin-time-slot {
        width: 100%;
        padding: 0.75rem;
        border-radius: 10px;
        border: 1px solid var(--card-border);
        background: rgba(15, 23, 42, 0.4);
        color: var(--text-muted);
        font-size: 0.85rem;
        transition: all 0.2s ease;
    }
    .admin-time-slot.is-available:hover {
        border-color: var(--primary);
        color: white;
    }
    .admin-time-slot.is-reserved {
        background: var(--primary);
        color: white;
        border-color: var(--primary);
    }
    .admin-time-slot.is-blocked {
        border-color: var(--error);
        color: var(--error);
    }

    .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        color: var(--text-muted);
    }
    .empty-state i {
        font-size: 3rem;
        opacity: 0.3;
    }

    h3 { font-family: 'Playfair Display', serif; margin-bottom: 1.5rem; color: var(--primary); }

    .block-day-checkbox-wrapper {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .block-day-checkbox-wrapper .form-check-input {
        background: rgba(15, 23, 42, 0.6);
        border: 1px solid var(--glass-border);
        border-radius: 4px;
        cursor: pointer;
        width: 1.2rem;
        height: 1.2rem;
    }

    .block-day-checkbox-wrapper .form-check-input:checked {
        background-color: var(--primary);
        border-color: var(--primary);
    }

    .block-day-checkbox-wrapper .form-check-label {
        margin-bottom: 0;
        cursor: pointer;
        font-size: 0.9rem;
        font-weight: 500;
        white-space: nowrap;
    }

    /* Selection Mode Styles for Time Slots */
    .time-slot-wrapper {
        position: relative;
    }

    .time-slot-wrapper.selected .admin-time-slot {
        background: rgba(96, 165, 250, 0.3);
        border-color: var(--primary);
        transform: scale(1.05);
    }

    .admin-time-slot {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .checkbox-display {
        display: none !important;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        background: rgba(96, 165, 250, 0.4);
        border: 2px solid rgba(96, 165, 250, 0.7);
        border-radius: 4px;
        color: rgba(96, 165, 250, 0.9);
        font-size: 14px;
        font-weight: bold;
        flex-shrink: 0;
    }

    .time-slot-wrapper.selected .checkbox-display {
        background: rgba(96, 165, 250, 0.6);
        border-color: var(--primary);
    }

    .time-slot-wrapper .time-slot-checkbox {
        position: absolute;
        top: -8px;
        right: -8px;
        width: 20px;
        height: 20px;
        cursor: pointer;
        z-index: 10;
    }

    .batch-actions-timeSlots {
        display: flex !important;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .batch-actions-timeSlots button {
        flex: 1;
        min-width: 150px;
    }
</style>

<script>
    let isSelectionMode = false;
    const selectedTimeSlots = new Set();

    function enterSelectionMode() {
        isSelectionMode = true;
        const selectionBtn = document.getElementById('selectionModeBtn');
        const batchActions = document.getElementById('batchActionsTimeSlots');

        // Show all checkboxes and their display spans
        document.querySelectorAll('.time-slot-checkbox').forEach(checkbox => {
            checkbox.style.display = 'none'; // Keep actual checkbox hidden
            const display = checkbox.parentElement.querySelector('.checkbox-display');
            if (display) {
                display.style.display = 'flex';
                display.innerHTML = '☐';
            }
        });

        // Show batch action buttons
        batchActions.style.display = 'flex';
        selectionBtn.disabled = true;
        selectionBtn.style.opacity = '0.5';

        // Add click handlers to time slot wrappers
        const wrappers = document.querySelectorAll('.time-slot-wrapper');
        wrappers.forEach(wrapper => {
            wrapper.addEventListener('click', toggleTimeSlotSelection);
        });
    }

    function exitTimeSlotSelectionMode() {
        isSelectionMode = false;
        selectedTimeSlots.clear();
        const batchActions = document.getElementById('batchActionsTimeSlots');
        const selectionBtn = document.getElementById('selectionModeBtn');

        // Hide all checkboxes and their display spans
        document.querySelectorAll('.time-slot-checkbox').forEach(checkbox => {
            checkbox.style.display = 'none';
            checkbox.checked = false;
            const display = checkbox.parentElement.querySelector('.checkbox-display');
            if (display) {
                display.style.display = 'none';
                display.innerHTML = '☐';
            }
        });

        // Hide batch action buttons
        batchActions.style.display = 'none';
        selectionBtn.disabled = false;
        selectionBtn.style.opacity = '1';

        // Remove selected class and click handlers
        const wrappers = document.querySelectorAll('.time-slot-wrapper');
        wrappers.forEach(wrapper => {
            wrapper.classList.remove('selected');
            wrapper.removeEventListener('click', toggleTimeSlotSelection);
        });
    }

    function toggleTimeSlotSelection(event) {
        if (!isSelectionMode) return;
        
        const wrapper = event.currentTarget;
        const time = wrapper.getAttribute('data-time');
        const checkbox = wrapper.querySelector('.time-slot-checkbox');
        const display = wrapper.querySelector('.checkbox-display');

        if (selectedTimeSlots.has(time)) {
            selectedTimeSlots.delete(time);
            wrapper.classList.remove('selected');
            checkbox.checked = false;
            if (display) display.innerHTML = '☐';
        } else {
            selectedTimeSlots.add(time);
            wrapper.classList.add('selected');
            checkbox.checked = true;
            if (display) display.innerHTML = '☑';
        }
    }
    
    // Handle form submission prevention in selection mode
    document.addEventListener('submit', function(event) {
        // Check if this form is within a time-slot-wrapper that's in selection mode
        const wrapper = event.target.closest('.time-slot-wrapper');
        if (wrapper && isSelectionMode) {
            event.preventDefault();
            const time = wrapper.getAttribute('data-time');
            const checkbox = wrapper.querySelector('.time-slot-checkbox');
            const display = wrapper.querySelector('.checkbox-display');
            
            if (selectedTimeSlots.has(time)) {
                selectedTimeSlots.delete(time);
                wrapper.classList.remove('selected');
                checkbox.checked = false;
                if (display) display.innerHTML = '☐';
            } else {
                selectedTimeSlots.add(time);
                wrapper.classList.add('selected');
                checkbox.checked = true;
                if (display) display.innerHTML = '☑';
            }
        }
    }, true); // Use capture phase to intercept before normal handling

    async function batchBlockTimeSlots() {
        if (selectedTimeSlots.size === 0) {
            alert('Please select at least one time slot');
            return;
        }

        const confirmed = confirm(`Block ${selectedTimeSlots.size} selected time slot(s)?`);
        if (!confirmed) return;

        // Get current date from URL or page
        const params = new URLSearchParams(window.location.search);
        const currentDate = params.get('Date') || new Date().toISOString().split('T')[0];
        const searchQuery = params.get('SearchQuery') || '';

        // Block each selected time slot
        const promises = [];
        for (const time of selectedTimeSlots) {
            const formData = new URLSearchParams();
            formData.append('time', time);
            formData.append('Date', currentDate);
            if (searchQuery) formData.append('SearchQuery', searchQuery);
            
            const promise = fetch(window.location.pathname + '?handler=ToggleSlot', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: formData
            }).catch(error => console.error('Error blocking time slot:', error));
            
            promises.push(promise);
        }
        
        // Wait for all requests to complete before reloading
        await Promise.all(promises);
        location.reload();
    }

    async function batchUnblockTimeSlots() {
        if (selectedTimeSlots.size === 0) {
            alert('Please select at least one time slot');
            return;
        }

        const confirmed = confirm(`Unblock ${selectedTimeSlots.size} selected time slot(s)?`);
        if (!confirmed) return;

        // Get current date from URL or page
        const params = new URLSearchParams(window.location.search);
        const currentDate = params.get('Date') || new Date().toISOString().split('T')[0];
        const searchQuery = params.get('SearchQuery') || '';

        // Unblock each selected time slot
        const promises = [];
        for (const time of selectedTimeSlots) {
            const formData = new URLSearchParams();
            formData.append('time', time);
            formData.append('Date', currentDate);
            if (searchQuery) formData.append('SearchQuery', searchQuery);
            
            const promise = fetch(window.location.pathname + '?handler=ToggleSlot', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: formData
            }).catch(error => console.error('Error unblocking time slot:', error));
            
            promises.push(promise);
        }
        
        // Wait for all requests to complete before reloading
        await Promise.all(promises);
        location.reload();
    }

    // Search only on Enter key press
    const searchInput = document.getElementById('searchInput');
    const searchForm = document.getElementById('searchForm');
    
    if (searchInput && searchForm) {
        searchInput.addEventListener('keypress', function(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                searchForm.submit();
            }
        });
    }
</script>
